# Dart / Flutter build artifacts
.dart_tool/
.packages
build/
coverage/
# Story 4.10: koel_http's merged headless-Chrome coverage pass (tool/coverage.sh with_chrome)
coverage_chrome/
# Generated Dart (*.g.dart / *.freezed.dart) is COMMITTED, not ignored:
# `dart pub publish` honors .gitignore, and ignoring them shipped uncompilable
# archives (koel_core/koel_http 1.1.0, koel_test 1.0.0 — fixed in v1.1.1).
# Git state must equal published state. *.mocks.dart stays ignored: test-only,
# never shipped to consumers' compilation, and none exist today.
*.mocks.dart

# Melos
.melos_tool/
pubspec_overrides.yaml

# Per-package pubspec.lock (workspace-level lock kept)
packages/*/pubspec.lock

# Flutter
**/ios/Pods/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Pods/
**/android/.gradle/
**/android/local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
**/.flutter-plugins
**/.flutter-plugins-dependencies

# DevTools extension build artifacts
packages/koel_devtools/extension/devtools/build/

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS
.DS_Store
Thumbs.db

# Logs and temp
*.log
.tmp/

# Secrets (defensive — none should ever be committed)
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
